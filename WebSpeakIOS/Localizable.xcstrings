    "使用 iOS 内置通话语音处理，尝试减轻背景声和回声；不是单独的降噪滤镜。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet die integrierte iOS-Sprachverarbeitung, um Hintergrundgeräusche und Echo zu verringern; kein separater Rauschfilter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses built-in iOS voice processing to try to reduce background noise and echo; it isn't a standalone noise filter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 内蔵の音声処理で背景音やエコーの軽減を試みます。独立したノイズフィルターではありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует встроенную обработку голоса iOS для уменьшения фонового шума и эха; это не отдельный фильтр шума."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 iOS 内置通话语音处理，尝试减轻背景声和回声；不是单独的降噪滤镜。"
          }
        }
      }
    },
